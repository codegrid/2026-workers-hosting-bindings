{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "2026-workers-hosting-bindings",
	"main": "@astrojs/cloudflare/entrypoints/server", // アダプターが提供するエントリーポイント
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist", // 静的に配信するディレクトリ
		"binding": "ASSETS",
	},
	// ログを記録する。デプロイ時にこの内容でダッシュボードの設定が上書きされる
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1, // 1 = 100%のリクエストを記録
	},

	// D1：製品とレビューのマスタ。コードからは env.DB で参照する
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codegrid-demo",
			"database_id": "00000000-0000-0000-0000-000000000000", // 自分のアカウントで作成したIDに置き換える
		},
	],

	// KV：表示用に整形したカタログのキャッシュ。コードからは env.CATALOG で参照する
	"kv_namespaces": [
		{
			"binding": "CATALOG",
			"id": "00000000000000000000000000000000", // 自分のアカウントで作成したIDに置き換える
		},
	],

	// Analytics Engine：製品ページの閲覧を記録する。コードからは env.ANALYTICS で参照する
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "catalog_views",
		},
	],

	// 別のWorker：レビュー本文の下ごしらえ。RPCで関数のように呼び出す
	"services": [
		{
			"binding": "REVIEW_PROCESSOR",
			"service": "review-processor", // workers/review-processor の name
			"entrypoint": "ReviewProcessor", // 呼び出すWorkerEntrypointクラス
		},
	],
}
