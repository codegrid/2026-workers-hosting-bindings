{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "2026-workers-hosting-bindings",
	"main": "@astrojs/cloudflare/entrypoints/server", // アダプターが提供するエントリーポイント
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist", // 静的に配信するディレクトリ
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},

	// D1：製品とレビューのマスタ。コードからは env.DB で参照する
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codegrid-demo",
			"database_id": "00000000-0000-0000-0000-000000000000", // 自分のアカウントで作成したIDに置き換える
		},
	],

	// KV：表示用に整形したカタログのキャッシュ。コードからは env.CATALOG で参照する
	"kv_namespaces": [
		{
			"binding": "CATALOG",
			"id": "00000000000000000000000000000000", // 自分のアカウントで作成したIDに置き換える
		},
	],
}
