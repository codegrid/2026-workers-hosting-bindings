---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | CG文具</title>
	</head>
	<body>
		<header>
			<a class="logo" href="/">CG文具</a>
			<nav>
				<a href="/">会社概要</a>
				<a href="/products/">製品カタログ</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>
				CodeGrid「Cloudflare Workersで作るWebサイトのホスティング」第4回のサンプルです。架空の会社・製品です。
			</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--fg: #1c1c1e;
		--bg: #fbfaf7;
		--muted: #6b6b70;
		--line: #e0ddd5;
		--accent: #b4502a;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--fg: #ececee;
			--bg: #1a1a1c;
			--muted: #a0a0a6;
			--line: #34343a;
			--accent: #e08a63;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: system-ui, sans-serif;
		line-height: 1.7;
	}

	header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: baseline;
		padding: 1rem 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	.logo {
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 1rem;
		font-size: 0.9rem;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	h1 {
		font-size: 1.6rem;
		margin: 0 0 1.5rem;
	}

	h2 {
		font-size: 1.1rem;
		margin: 2.5rem 0 1rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid var(--line);
	}

	footer {
		max-width: 44rem;
		margin: 0 auto;
		padding: 1.5rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8rem;
	}

	.muted {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.price {
		font-weight: 700;
		color: var(--accent);
	}
</style>
