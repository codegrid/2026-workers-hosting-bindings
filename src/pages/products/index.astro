---
// 製品カタログの一覧。D1とKVを読むのでオンデマンドレンダリングにする
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getCatalog } from "../../lib/catalog";

// KVにキャッシュがあればKVから、なければD1から組み立ててKVに入れる
const { items, source } = await getCatalog();
---

<Layout title="製品カタログ">
	<h1>製品カタログ</h1>

	<p class="muted">
		このページのデータは<strong>{source}</strong>から読み出しました。リロードすると2回目以降はKVになります。
	</p>

	<ul class="products">
		{
			items.map((item) => (
				<li>
					<a href={`/products/${item.id}/`}>{item.name}</a>
					<p class="muted">
						{item.category} ／ <span class="price">{item.priceLabel}</span>
						{item.averageRating !== null && (
							<span>
								{" "}
								／ ★{item.averageRating.toFixed(1)}（{item.reviewCount}件）
							</span>
						)}
					</p>
					<p>{item.description}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.products {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.products li {
		padding: 1.2rem 0;
		border-bottom: 1px solid var(--line);
	}

	.products li p {
		margin: 0.2rem 0 0;
	}

	.products a {
		font-weight: 700;
	}
</style>
