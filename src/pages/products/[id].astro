---
// 製品の詳細ページ。製品とレビューをD1から読み出す
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getProduct, listReviews } from "../../lib/catalog";

const { id } = Astro.params;
const product = id ? await getProduct(id) : null;

if (!product) {
	return new Response(null, { status: 404 });
}

const reviews = await listReviews(product.id);
const average =
	reviews.length === 0
		? null
		: reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length;

const posted = Astro.url.searchParams.has("posted");
const invalid = Astro.url.searchParams.get("error") === "invalid";
const spam = Astro.url.searchParams.get("error") === "spam";
---

<Layout title={product.name}>
	<h1>{product.name}</h1>

	<p class="muted">
		{product.category} ／ <span class="price">{product.price.toLocaleString("ja-JP")}円</span>
	</p>

	<p>{product.description}</p>

	<h2>レビュー（{reviews.length}件）</h2>

	{average !== null && <p class="muted">平均評価：★{average.toFixed(1)}</p>}

	{reviews.length === 0 && <p class="muted">まだレビューはありません。</p>}

	<ul class="reviews">
		{
			reviews.map((review) => (
				<li>
					<p class="rating">{"★".repeat(review.rating)}</p>
					<p>{review.body}</p>
					<p class="muted">{review.created_at}</p>
				</li>
			))
		}
	</ul>

	<h2>レビューを書く</h2>

	{posted && <p class="notice">レビューを投稿しました。</p>}
	{invalid && <p class="notice">評価と本文を入力してください。</p>}
	{spam && <p class="notice">宣伝のような内容は投稿できません。</p>}

	<form method="post" action="/api/reviews">
		<input type="hidden" name="product_id" value={product.id} />

		<label>
			評価
			<select name="rating">
				{[5, 4, 3, 2, 1].map((value) => <option value={value}>{"★".repeat(value)}</option>)}
			</select>
		</label>

		<label>
			本文
			<textarea name="body" rows="3" placeholder="使ってみた感想をどうぞ"></textarea>
		</label>

		<button type="submit">投稿する</button>
	</form>

	<p><a href="/products/">← 製品カタログに戻る</a></p>
</Layout>

<style>
	.reviews {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.reviews li {
		padding: 1rem 0;
		border-bottom: 1px solid var(--line);
	}

	.reviews li p {
		margin: 0;
	}

	.rating {
		color: var(--accent);
		letter-spacing: 0.1em;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		align-items: flex-start;
		max-width: 28rem;
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		width: 100%;
		font-size: 0.9rem;
	}

	select,
	textarea,
	button {
		font: inherit;
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 4px;
		background: transparent;
		color: inherit;
	}

	button {
		cursor: pointer;
		border-color: var(--accent);
		color: var(--accent);
	}

	.notice {
		padding: 0.6rem 0.8rem;
		border-left: 3px solid var(--accent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}
</style>
