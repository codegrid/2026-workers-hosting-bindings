{
  "name": "2026-workers-hosting-bindings",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply codegrid-demo-dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply codegrid-demo-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply codegrid-demo --remote",
    "deploy": "astro build && wrangler deploy -c workers/review-processor/wrangler.jsonc && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=prod astro build && wrangler deploy -c workers/review-processor/wrangler.jsonc --env prod && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
